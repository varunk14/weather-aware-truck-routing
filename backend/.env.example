# Copy to backend/.env for local development. Never commit the real file.

# Required in production. Development falls back to an insecure placeholder.
DJANGO_SECRET_KEY=

# Comma-separated. Development defaults to localhost.
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# DEBUG, INFO, WARNING or ERROR.
DJANGO_LOG_LEVEL=INFO

# Routing and geocoding. Required to plan trips.
TOMTOM_API_KEY=
